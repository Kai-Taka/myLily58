#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/keys.h>

/ {
    combos {
        compatible = "zmk,combos";

        f12 {
            bindings = <&kp F12>;
            key-positions = <1 2 55>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        adjust {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp ESC    &kp N1  &kp N2  &kp N3        &kp N4        &kp N5                         &kp N6  &kp N7     &kp N8         &kp N9   &kp N0    &kp GRAVE
&kp TAB    &kp Q   &kp W   &kp E         &kp R         &kp T                          &kp Y   &kp U      &kp I          &kp O    &kp P     &kp MINUS
&kp LCTRL  &kp A   &kp S   &kp D         &kp F         &kp G                          &kp H   &kp J      &kp K          &kp L    &kp SEMI  &kp SQT
&kp LSHFT  &kp Z   &kp X   &kp C         &kp V         &kp B   &kp LBKT     &kp RBKT  &kp N   &kp M      &kp COMMA      &kp DOT  &kp FSLH  &kp DEL
                           &kp LEFT_WIN  &kp LEFT_ALT  &mo 1   &kp SPACE    &kp RET   &mo 2   &kp EQUAL  &kp BACKSPACE
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        // Hold left thumb: all F-keys under the left hand (gaming extra buttons)
        fn_layer {
            bindings = <
&kp F21  &kp F1   &kp F2   &kp F3   &kp F4   &kp F5                       &trans  &trans  &trans  &trans  &trans  &trans
&kp F22  &kp F6   &kp F7   &kp F8   &kp F9   &kp F10                      &trans  &trans  &trans  &trans  &trans  &trans
&kp F23  &kp F11  &kp F12  &kp F13  &kp F14  &kp F15                      &trans  &trans  &trans  &trans  &trans  &trans
&kp F24  &kp F16  &kp F17  &kp F18  &kp F19  &kp F20  &trans      &trans  &trans  &trans  &trans  &trans  &trans  &trans
                           &trans   &trans   &trans   &trans      &trans  &trans  &trans  &trans
            >;
        };

        // Hold right thumb: arrows, navigation, media
        nav_layer {
            bindings = <
&trans  &trans      &trans    &trans    &trans  &trans                    &trans     &trans     &trans    &trans     &trans  &trans
&trans  &kp C_MUTE  &kp C_VOL_DN  &kp C_VOL_UP  &trans  &trans            &kp PG_UP  &kp HOME   &kp UP    &kp END    &trans  &kp BSLH
&trans  &kp C_PREV  &kp C_PP  &kp C_NEXT  &trans  &trans                  &kp PG_DN  &kp LEFT   &kp DOWN  &kp RIGHT  &trans  &trans
&trans  &trans      &trans    &trans    &trans  &trans  &trans    &trans  &kp INS    &kp PSCRN  &trans    &trans     &trans  &trans
                              &trans    &trans  &trans  &trans    &trans  &trans     &trans     &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        // Hold both thumbs: Bluetooth, output, bootloader, reset
        adjust_layer {
            bindings = <
&bt BT_CLR   &bt BT_SEL 0   &bt BT_SEL 1   &bt BT_SEL 2    &bt BT_SEL 3  &bt BT_SEL 4                    &trans  &trans  &trans  &trans  &trans  &bootloader
&trans       &out OUT_USB   &out OUT_BLE   &out OUT_TOG    &trans        &trans                          &trans  &trans  &trans  &trans  &trans  &sys_reset
&sys_reset   &trans         &trans         &trans          &trans        &trans                          &trans  &trans  &trans  &trans  &trans  &trans
&bootloader  &trans         &trans         &trans          &trans        &trans        &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
                                           &trans          &trans        &trans        &trans    &trans  &trans  &trans  &trans
            >;
        };
    };
};
